# Razorpay Standard Checkout (STEMLab Premium purchase)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
# Set to the secret shown when creating the webhook in Razorpay Dashboard >
# Settings > Webhooks (not the same value as RAZORPAY_KEY_SECRET above).
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
